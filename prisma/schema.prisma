generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum MatchOutcome {
  X_WIN
  O_WIN
  DRAW
}

enum GameDefinitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  score        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roomsAsX     GameRoom[] @relation("PlayerX")
  roomsAsO     GameRoom[] @relation("PlayerO")
  wins         GameRoom[] @relation("Winner")
  matchesAsX   Match[]    @relation("MatchX")
  matchesAsO   Match[]    @relation("MatchO")
  wonMatches   Match[]    @relation("MatchWinner")
  gameDefinitions GameDefinition[] @relation("GameCreator")
  roomParticipants RoomParticipant[]
  gameEvents GameEvent[] @relation("EventActor")
}

model GameDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  version     Int      @default(1)
  status      GameDefinitionStatus @default(DRAFT)
  definition  Json
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  creator     User @relation("GameCreator", fields: [creatorId], references: [id])
  rooms       GameRoom[]
  @@index([creatorId, status])
  @@index([status, updatedAt])
}

model GameRoom {
  id        String     @id @default(cuid())
  code      String     @unique
  gameType  String     @default("TIC_TAC_TOE")
  status    RoomStatus @default(WAITING)
  board     Json       @default("[null,null,null,null,null,null,null,null,null]")
  turn      String     @default("X")
  playerXId String
  playerOId String?
  winnerId  String?
  createdAt DateTime   @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  gameDefinitionId String?
  playerX User @relation("PlayerX", fields: [playerXId], references: [id])
  playerO User? @relation("PlayerO", fields: [playerOId], references: [id])
  winner  User? @relation("Winner", fields: [winnerId], references: [id])
  gameDefinition GameDefinition? @relation(fields: [gameDefinitionId], references: [id])
  participants RoomParticipant[]
  events GameEvent[]
  match   Match?
  @@index([status, createdAt])
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  team     String?
  joinedAt DateTime @default(now())
  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@index([roomId, team])
}

model GameEvent {
  id         String   @id @default(cuid())
  roomId     String?
  actorId    String?
  type       String
  sequence   Int
  payload    Json
  occurredAt DateTime @default(now())
  room GameRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor User? @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@unique([roomId, sequence])
  @@index([type, occurredAt])
  @@index([actorId, occurredAt])
}

model Match {
  id          String       @id @default(cuid())
  roomId      String       @unique
  playerXId   String
  playerOId   String
  winnerId    String?
  outcome     MatchOutcome
  moves       Int
  completedAt DateTime     @default(now())
  room    GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerX User     @relation("MatchX", fields: [playerXId], references: [id])
  playerO User     @relation("MatchO", fields: [playerOId], references: [id])
  winner  User?    @relation("MatchWinner", fields: [winnerId], references: [id])
  @@index([completedAt])
}
